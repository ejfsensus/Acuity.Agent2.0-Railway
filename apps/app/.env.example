# =============================================================================
# Acuity.Agent - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# See docs/ENVIRONMENT.md for detailed descriptions.

# --- Authentication ----------------------------------------------------------

BETTER_AUTH_SECRET=          # Random secret for signing sessions (generate with: openssl rand -hex 32)
BETTER_AUTH_API_KEY=         # Better Auth Infra API key, if using the hosted Better Auth app
NUXT_PUBLIC_SITE_URL=         # Public app URL used for OAuth callbacks, e.g. https://acuity-agent.vercel.app
NUXT_PUBLIC_GITHUB_LOGIN_ENABLED=false # Set true after adding GitHub OAuth credentials
AUTHORIZED_USER_EMAILS=developments@sensusinvista.ltd # Comma-separated allowlist while in development
GITHUB_CLIENT_ID=            # GitHub OAuth app client ID
GITHUB_CLIENT_SECRET=        # GitHub OAuth app client secret

# --- AI ----------------------------------------------------------------------

# AI_GATEWAY_API_KEY=        # Vercel AI Gateway API key (only needed for local dev, Vercel uses OIDC)
BRAVE_API_KEY=              # Brave Search API key for web_search and brave_llm_context tools

# Optional: switch the app to any OpenAI-compatible endpoint.
# AI_PROVIDER=gateway                         # gateway | openai-compatible
# AI_MODELS=deepseek/deepseek-v4-pro,minimax/minimax-m2.7
# AI_DEFAULT_MODEL=deepseek/deepseek-v4-pro
# AI_ROUTER_MODEL=minimax/minimax-m2.7
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_NAME=openai-compatible
# OPENAI_COMPATIBLE_MODELS=gpt-4o-mini,gpt-4o
# OPENAI_COMPATIBLE_DEFAULT_MODEL=gpt-4o-mini
# OPENAI_COMPATIBLE_ROUTER_MODEL=gpt-4o-mini
# NUXT_PUBLIC_AI_MODELS=                      # Optional UI-visible model list; falls back to AI_MODELS
# NUXT_PUBLIC_AI_DEFAULT_MODEL=               # Optional UI-visible default model

# --- Sandbox & Sync ----------------------------------------------------------

# NUXT_GITHUB_SNAPSHOT_REPO= # Default snapshot repository (owner/repo format)
# NUXT_GITHUB_SNAPSHOT_BRANCH=main
# NUXT_GITHUB_TOKEN=         # Optional PAT override for snapshot git operations
#                           # If omitted, the app uses GitHub App installation tokens

# --- GitHub Bot (optional) ---------------------------------------------------

# NUXT_PUBLIC_GITHUB_APP_NAME=your-bot-name     # GitHub App name (used for install URL and bot username)
# NUXT_PUBLIC_GITHUB_BOT_TRIGGER=               # Override bot mention trigger (defaults to app name)
# NUXT_GITHUB_APP_ID=
# NUXT_GITHUB_APP_PRIVATE_KEY=
# NUXT_GITHUB_WEBHOOK_SECRET=

# --- Discord Bot (optional) --------------------------------------------------

# NUXT_PUBLIC_DISCORD_BOT_URL=               # Full Discord bot invite URL
# NUXT_DISCORD_BOT_TOKEN=
# NUXT_DISCORD_PUBLIC_KEY=
# NUXT_DISCORD_APPLICATION_ID=
# NUXT_DISCORD_MENTION_ROLE_IDS=

# --- YouTube (optional) ------------------------------------------------------

# NUXT_YOUTUBE_API_KEY=

# --- Storage (optional) ------------------------------------------------------

# POSTGRES_URL=              # Recommended: Neon/Postgres connection URL for persistent auth, sources, chats, and usage data
# DATABASE_URL=              # Alternative name used by some Postgres providers
# BLOB_READ_WRITE_TOKEN=     # Vercel Blob token for file uploads

# --- State (optional) --------------------------------------------------------

# REDIS_URL=                  # Redis URL for durable KV/cache state in production
# EVLOG_TRANSPORT_ENABLED=false # Set true only if you want API logs retained in the database
