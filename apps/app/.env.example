# Local development: copy to apps/app/.env. Production values belong in Railway.
# See docs/ENVIRONMENT.md and docs/RAILWAY-DEPLOYMENT.md.

# Authentication: use the same random value for both secrets in production.
BETTER_AUTH_SECRET=
NUXT_BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NUXT_PUBLIC_SITE_URL=http://localhost:3000
AUTHORIZED_USER_EMAILS=developments@sensusinvista.ltd
NUXT_PUBLIC_GITHUB_LOGIN_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Postgres is required in production; PGlite is a local development fallback.
# POSTGRES_URL=

# DeepSeek/OpenAI-compatible model configuration.
AI_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_NAME=openai-compatible
OPENAI_COMPATIBLE_MODELS=deepseek-flash,deepseek-v4-pro
OPENAI_COMPATIBLE_DEFAULT_MODEL=deepseek-flash
# OPENAI_COMPATIBLE_ROUTER_MODEL=deepseek-flash
NUXT_PUBLIC_AI_MODELS=deepseek-flash,deepseek-v4-pro
NUXT_PUBLIC_AI_DEFAULT_MODEL=deepseek-flash
NUXT_PUBLIC_AI_PROVIDER_NAME=DeepSeek
BRAVE_API_KEY=
# Gateway mode on Railway requires an explicit AI_GATEWAY_API_KEY.

# The bundled corpus works without a snapshot repository.
# NUXT_GITHUB_SNAPSHOT_REPO=owner/knowledge-repository
# NUXT_GITHUB_SNAPSHOT_BRANCH=main
# NUXT_GITHUB_TOKEN=
# NUXT_GITHUB_APP_ID=
# NUXT_GITHUB_APP_PRIVATE_KEY=
# NUXT_PUBLIC_GITHUB_APP_NAME=your-app-slug
# NUXT_PUBLIC_GITHUB_BOT_TRIGGER=
# NUXT_GITHUB_WEBHOOK_SECRET=
# NUXT_YOUTUBE_API_KEY=

# Private S3-compatible storage for attachments and uploaded sources.
# AWS_ENDPOINT_URL=
# AWS_REGION=auto
# AWS_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BLOB_SIGNING_SECRET=

# Optional Discord integration and durable bot state.
# NUXT_DISCORD_BOT_TOKEN=
# NUXT_DISCORD_PUBLIC_KEY=
# NUXT_DISCORD_APPLICATION_ID=
# NUXT_DISCORD_MENTION_ROLE_IDS=
# NUXT_PUBLIC_DISCORD_BOT_URL=
# DISCORD_GATEWAY_ENABLED=false
# REDIS_URL=
# EVLOG_TRANSPORT_ENABLED=false
